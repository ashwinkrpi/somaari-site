---
// Starlight's page footer (previous/next links), then the shared Somaari footer: markup from somaari-common's
// footer.mjs (downloaded into public/theme/ by scripts/import-theme.mjs), styles from /theme/footer.css
// (linked in astro.config.mjs). Change the footer in somaari-common, not here.
import Default from '@astrojs/starlight/components/Footer.astro';
import network from '../../network.json';
import { footer } from '../../public/theme/footer.mjs';
---

<Default />
<Fragment set:html={footer(network)} />
